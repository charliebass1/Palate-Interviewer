# ---------------------------------------------------------------------------
# Mock / demo mode
# ---------------------------------------------------------------------------
# Leave EVERYTHING below blank and the app runs in mock mode: an in-memory
# database (pre-seeded with two demo projects), deterministic stand-ins for the
# Claude calls, and a simulated voice-call pipeline. No accounts or keys
# required — `npm install && npm run dev`, then click through the whole flow.
#
# Mock mode turns on automatically whenever Supabase isn't configured. Force it
# on with PALATE_MOCK_MODE=true, or force the live backend with =false. Fill in
# the real credentials below to switch to the live path (no code changes).
PALATE_MOCK_MODE=

# Anthropic
ANTHROPIC_API_KEY=sk-ant-...
# Cheap/fast default. Upgrade to claude-sonnet-4-6 or claude-opus-4-7 for
# higher-quality guide generation and post-call analysis on complex topics.
ANTHROPIC_MODEL=claude-haiku-4-5

# Supabase
# As of late 2025 Supabase replaced anon / service_role with publishable /
# secret keys. New projects only show the new format (sb_publishable_... and
# sb_secret_...). The env loader also accepts the legacy names
# NEXT_PUBLIC_SUPABASE_ANON_KEY and SUPABASE_SERVICE_ROLE_KEY for older
# projects whose keys weren't rotated.
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_SECRET_KEY=sb_secret_...

# Vapi (voice orchestration)
VAPI_API_KEY=
VAPI_WEBHOOK_SECRET=
VAPI_ASSISTANT_ID=
# Optional: your provisioned Vapi phone number for outbound expert calls
VAPI_PHONE_NUMBER_ID=

# Optional: Deepgram / ElevenLabs (if proxied through app)
DEEPGRAM_API_KEY=
ELEVENLABS_API_KEY=

# Optional: LlamaParse for richer PDF ingestion
LLAMA_CLOUD_API_KEY=

# App
APP_URL=http://localhost:3000

# Dev tools (paste-in transcript to bypass a real Vapi call). Set to true
# in local/dev environments only.
NEXT_PUBLIC_ENABLE_DEV_TOOLS=false

# Hides the /debug pre-flight page once initial config is stable.
DEBUG_DISABLED=false
