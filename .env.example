# Anthropic
ANTHROPIC_API_KEY=sk-ant-...
# Cheap/fast default. Upgrade to claude-sonnet-4-6 or claude-opus-4-7 for
# higher-quality guide generation and post-call analysis on complex topics.
ANTHROPIC_MODEL=claude-haiku-4-5

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Vapi (voice orchestration)
VAPI_API_KEY=
VAPI_WEBHOOK_SECRET=
VAPI_ASSISTANT_ID=
# Optional: your provisioned Vapi phone number for outbound expert calls
VAPI_PHONE_NUMBER_ID=

# Optional: Deepgram / ElevenLabs (if proxied through app)
DEEPGRAM_API_KEY=
ELEVENLABS_API_KEY=

# Optional: LlamaParse for richer PDF ingestion
LLAMA_CLOUD_API_KEY=

# App
APP_URL=http://localhost:3000
